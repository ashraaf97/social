# Infisical service token for the Development environment (generate in your project).
INFISICAL_TOKEN=
INFISICAL_API_URL=https://app.infisical.com/api
INFISICAL_SECRET_ENV=dev

# Postgres credentials (used by the postgres service). Spring Boot DB URL/user/password
# are expected to come from Infisical at runtime, so they are not listed here.

# Optional local overrides for the postgres service when Infisical is not yet wired up.
APP_DB_USER=social
APP_DB_PASSWORD=social